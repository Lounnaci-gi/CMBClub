{
  "expo": {
    "name": "CMBClub",
    "slug": "CMBClub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1923"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "CMBClub a besoin d'accéder à votre caméra pour prendre des photos d'adhérents."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CMBClub a besoin d'accéder à votre galerie pour sélectionner des photos."
        }
      ],
      "expo-sqlite",
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cmbclub.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0F1923"
      },
      "package": "com.cmbclub.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
