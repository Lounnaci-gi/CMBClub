# ─── CMBClub – Variables d'environnement React Native ───────────────────────
# Copiez ce fichier en `.env` et remplissez les valeurs réelles.
# Ce fichier PEUT être commité (il ne contient pas de vraies valeurs).

# URL du backend Cloudflare Worker
CLOUDFLARE_API_URL=https://your-worker.workers.dev

# Clé de chiffrement XOR des noms d'utilisateur
# Doit être identique à USERNAME_CIPHER_KEY dans backend/.dev.vars
USERNAME_CIPHER_KEY=your-cipher-key-here
