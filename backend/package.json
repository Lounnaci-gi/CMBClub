{
  "name": "cmbclub-backend",
  "version": "1.0.0",
  "description": "Cloudflare Worker & D1 Backend for CMBClub",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:init:local": "wrangler d1 execute cmbclub-db --local --file=./schema.sql",
    "d1:init:remote": "wrangler d1 execute cmbclub-db --remote --file=./schema.sql"
  },
  "dependencies": {
    "hono": "^4.7.2"
  },
  "devDependencies": {
    "wrangler": "^4.123.0"
  }
}
